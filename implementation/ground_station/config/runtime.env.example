# Copy to runtime.env (ignored by Git) and supply your own deployment settings.
# Use the same Realtime Database URL as the mobile application.
GS_FIREBASE_DATABASE_URL=https://EXTERNAL_FIREBASE_PROJECT_ID-default-rtdb.firebaseio.com
# Local path to your private service-account JSON file; never paste its contents here.
# Keep that JSON file outside the repository.
GS_FIREBASE_CREDENTIALS=/path/to/serviceAccountKey.json
GS_T_LOCATION_UPDATE_SECONDS=
GS_T_WAIT_SECONDS=
GS_EVENT_TIMEZONE=Asia/Hong_Kong
GS_STATE_DIR=/path/to/private-ground-station-state
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
