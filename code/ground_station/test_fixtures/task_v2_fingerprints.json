  "required_rejection_cases": [
    "same execution_id with changed fingerprint",
    "v2 mission_id missing",
    "v2 execution_id missing",
    "boolean coordinate",
    "nonfinite coordinate",
    "out of range coordinate",
    "empty waypoints",
    "1001 source waypoints"
  ],
  "normalization_notes": [
    "Numeric inputs normalize to finite float; numeric zero becomes positive 0.0.",
    "Coordinate long key takes precedence over short alias even when zero.",
    "Missing return_to_launch normalizes to true; only JSON booleans accepted.",
    "Missing or null altitude and hover_seconds normalize to null, not deployment defaults.",
    "mission_id and mission_type retain case and must satisfy agreed token validation.",
    "execution_id, schema_version and transport metadata do not enter the content fingerprint.",
    "mission_id and schema v1 phone-record hash/ACK semantics remain unchanged."
  ]
